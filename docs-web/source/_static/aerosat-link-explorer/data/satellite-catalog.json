{
  "schemaVersion": "1.0.0",
  "catalogId": "pvg-cdg-public-satellites",
  "title": "PVG–CDG 航路公开卫星目录（GEO / LEO）",
  "description": "基于公开资料整理的上海浦东—巴黎戴高乐代表性航路相关卫星清单。用于项目 data.js 维护、仰角分析与 LEO TLE 加载对接。非运营商实时链路数据。",
  "routeId": "PVG-CDG",
  "lastUpdated": "2026-06-08",
  "disclaimer": "本目录不表示某次具体航班实际接入的卫星；LEO 条目为星座级公开 TLE 源，非逐星 aviation IFC 授权清单。",

  "projectIntegration": {
    "runtimeFile": "src/data.js",
    "geoField": "AEROSAT_DATA.geoSatellites",
    "leoFeedField": "AEROSAT_DATA.publicSatelliteFeeds",
    "providerField": "AEROSAT_DATA.providers",
    "geoRuntimeShape": {
      "id": "string — 项目内唯一键，如 i5-f1",
      "name": "string — 显示名称",
      "operator": "string",
      "lon": "number — 星下点经度（度，东经为正，西经为负）",
      "band": "string — 如 Ka、Ku、L",
      "sourceId": "string — 对应 AEROSAT_DATA.sources 的键"
    },
    "leoFeedRuntimeShape": {
      "id": "string — 如 starlink",
      "label": "string",
      "provider": "string",
      "shellId": "leo",
      "color": "string — CSS 色值",
      "url": "string — CelesTrak GP JSON URL"
    },
    "syncWorkflow": [
      "1. 更新本 JSON 中 geoSatellites.recommendedForElevation 条目",
      "2. 将 lon / name / id 同步到 src/data.js 的 geoSatellites 数组",
      "3. 在 sources 中补充或修正 sourceId 引用",
      "4. 刷新浏览器，检查 Analysis 面板 per-satellite 表与航迹着色",
      "5. LEO：更新 publicSatelliteFeeds 的 url 或 celestrakGroup 即可，无需逐星录入"
    ],
    "knownDataJsCorrections": [
      {
        "id": "i5-f4",
        "field": "lon",
        "currentInDataJs": 83.0,
        "correctValue": 56.5,
        "reason": "83°E 为 Inmarsat-6 F1 星下点，非 I-5 F4"
      },
      {
        "id": "i6-f1",
        "field": "lon",
        "currentInDataJs": 64.0,
        "correctValue": 83.8,
        "reason": "SatSig / N2YO 公开跟踪约 83.8°E"
      }
    ],
    "recommendedGeoAdditions": ["i5-f3", "i5-f5"]
  },

